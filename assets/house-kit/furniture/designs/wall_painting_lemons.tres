[gd_resource type="Resource" script_class="FurnitureDesign" format=3]

[ext_resource type="Script" path="res://scripts/house-kit/furniture/furniture_design.gd" id="design"]
[ext_resource type="Script" path="res://scripts/house-kit/furniture/furniture_view.gd" id="view"]
[ext_resource type="Texture2D" path="res://assets/house-kit/furniture/sprites/wall_painting_lemons.png" id="albedo"]
[ext_resource type="Texture2D" path="res://assets/house-kit/furniture/sprites/wall_painting_lemons_approved.png" id="approved"]
[ext_resource type="Texture2D" path="res://assets/house-kit/furniture/sprites/wall_painting_lemons_materials.png" id="mask"]

[sub_resource type="Resource" id="front"]
script = ExtResource("view")
albedo = ExtResource("albedo")
material_mask = ExtResource("mask")
approved_preview = ExtResource("approved")
origin = Vector2(-10, -14)

[resource]
script = ExtResource("design")
title = "Лимоны и кувшин"
views = Array[ExtResource("view")]([SubResource("front")])
