[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/world-kit/placement_group.gd" id="placement"]
[ext_resource type="PackedScene" path="res://scenes/world-kit/furniture/sideboard.tscn" id="sideboard"]
[ext_resource type="PackedScene" path="res://scenes/world-kit/furniture/turntable.tscn" id="turntable"]
[ext_resource type="PackedScene" path="res://scenes/world-kit/furniture/tape_recorder.tscn" id="tape_recorder"]
[ext_resource type="PackedScene" path="res://scenes/world-kit/furniture/marble_bust.tscn" id="bust"]
[ext_resource type="Resource" path="res://assets/world-kit/furniture/groups/dining_for_two_variants.tres" id="styles"]

[node name="EquipmentPlacement" type="Node2D"]
script = ExtResource("placement")
style_variants = ExtResource("styles")
selected_variant = &"Turntable"

[node name="Turntable" type="Marker2D" parent="."]

[node name="Sideboard" parent="Turntable" instance=ExtResource("sideboard")]

[node name="Turntable" parent="Turntable/Sideboard" instance=ExtResource("turntable")]
position = Vector2(0, -17)

[node name="TapeRecorder" type="Marker2D" parent="."]

[node name="Sideboard" parent="TapeRecorder" instance=ExtResource("sideboard")]

[node name="TapeRecorder" parent="TapeRecorder/Sideboard" instance=ExtResource("tape_recorder")]
position = Vector2(0, -17)

[node name="MarbleBust" type="Marker2D" parent="."]

[node name="MarbleBust" parent="MarbleBust" instance=ExtResource("bust")]
